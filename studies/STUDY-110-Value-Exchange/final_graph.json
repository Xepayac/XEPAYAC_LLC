{
  "nodes": [
    {
      "id": "auth-system",
      "type": "CONCEPT",
      "data": {
        "description": "User authentication system that verifies user identity and manages access"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:09.040563+00:00",
        "modified_at": "2025-12-18T16:28:09.040563+00:00"
      }
    },
    {
      "id": "credential-validation",
      "type": "CONCEPT",
      "data": {
        "description": "Validate user credentials (username/password) against stored data"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:09.040599+00:00",
        "modified_at": "2025-12-18T16:28:09.040599+00:00"
      }
    },
    {
      "id": "session-management",
      "type": "CONCEPT",
      "data": {
        "description": "Create and maintain user sessions after successful authentication"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:09.040613+00:00",
        "modified_at": "2025-12-18T16:28:09.040613+00:00"
      }
    },
    {
      "id": "password-hashing",
      "type": "CONCEPT",
      "data": {
        "description": "Use bcrypt or similar strong hashing algorithm for password storage"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:09.040622+00:00",
        "modified_at": "2025-12-18T16:28:09.040622+00:00"
      }
    },
    {
      "id": "user-datastore",
      "type": "CONCEPT",
      "data": {
        "description": "Database or storage system containing user credentials and profile data"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:09.040629+00:00",
        "modified_at": "2025-12-18T16:28:09.040629+00:00"
      }
    },
    {
      "id": "security-first",
      "type": "PATTERN",
      "data": {
        "description": "Prioritize security over convenience in authentication design decisions"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:09.040635+00:00",
        "modified_at": "2025-12-18T16:28:09.040635+00:00"
      }
    },
    {
      "id": "logout-mechanism",
      "type": "BEHAVIOR",
      "data": {
        "description": "Allow users to explicitly end their session and invalidate session tokens"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:17.975621+00:00",
        "modified_at": "2025-12-18T16:28:17.975621+00:00"
      }
    },
    {
      "id": "rate-limiting",
      "type": "BEHAVIOR",
      "data": {
        "description": "Limit authentication attempts to prevent brute force attacks"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:17.975646+00:00",
        "modified_at": "2025-12-18T16:28:17.975646+00:00"
      }
    },
    {
      "id": "input-validation",
      "type": "BEHAVIOR",
      "data": {
        "description": "Sanitize and validate all user inputs to prevent injection attacks"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:17.975653+00:00",
        "modified_at": "2025-12-18T16:28:17.975653+00:00"
      }
    },
    {
      "id": "session-timeout",
      "type": "CONCEPT",
      "data": {
        "description": "Sessions automatically expire after predetermined period of inactivity"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:17.975668+00:00",
        "modified_at": "2025-12-18T16:28:17.975668+00:00"
      }
    },
    {
      "id": "error-handling",
      "type": "BEHAVIOR",
      "data": {
        "description": "Handle authentication failures gracefully with appropriate error messages without revealing system details"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:28.224802+00:00",
        "modified_at": "2025-12-18T16:28:28.224802+00:00"
      }
    },
    {
      "id": "user-registration",
      "type": "CONCEPT",
      "data": {
        "description": "Process for creating new user accounts with proper validation and credential setup"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:28.224833+00:00",
        "modified_at": "2025-12-18T16:28:28.224833+00:00"
      }
    },
    {
      "id": "password-policy",
      "type": "CONCEPT",
      "data": {
        "description": "Enforce minimum password complexity requirements (length, character types, common password checks)"
      },
      "metadata": {
        "created_by": "Alpha",
        "created_at": "2025-12-18T16:28:28.224844+00:00",
        "modified_at": "2025-12-18T16:28:28.224844+00:00"
      }
    },
    {
      "id": "auth-strategy-decision",
      "type": "CONCEPT",
      "data": {
        "description": "Choose between stateful session-based authentication or stateless token-based (JWT) authentication"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:38.851194+00:00",
        "modified_at": "2025-12-18T16:28:38.851194+00:00"
      }
    },
    {
      "id": "multi-factor-auth",
      "type": "CONCEPT",
      "data": {
        "description": "Optional second authentication factor (SMS, TOTP, email) for enhanced security"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:38.851218+00:00",
        "modified_at": "2025-12-18T16:28:38.851218+00:00"
      }
    },
    {
      "id": "account-lockout",
      "type": "BEHAVIOR",
      "data": {
        "description": "Temporarily lock user accounts after consecutive failed authentication attempts"
      },
      "metadata": {
        "created_by": "Beta",
        "created_at": "2025-12-18T16:28:38.851225+00:00",
        "modified_at": "2025-12-18T16:28:38.851225+00:00"
      }
    },
    {
